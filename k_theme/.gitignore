# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Django 실행/개발 산출물 (커밋하면 안 되는 것들) ---
db.sqlite3
*.log

# collectstatic 결과물(STATIC_ROOT). admin/, cloudinary/, django_extensions/ 등은
# `python manage.py collectstatic`으로 언제든 다시 만들어지는 빌드 산출물이라 git에 올릴 필요가 없다.
# 단, KakaoTalkTheme.css / Images/ 원본 소스는 main/static/ 쪽으로 옮긴 뒤에 이 규칙을 적용할 것.
/static/

# 사용자가 만든 테마 결과물 (업로드 이미지, 생성된 CSS/zip). 서버에서 생성되는 데이터이므로
# git에는 필요 없고, 계속 쌓이면 저장소만 무거워진다.
/media/

# 에디터/OS
.vscode/
.idea/
*.swp
.DS_Store

# 이번에 발견된 정체불명 산출물 — 배포에 쓸모없다면 삭제 검토
main.zip
models.dot
